                            "raw": "{\n    \"service_type\": \"Haircut\",\n    \"appointment_date\": \"2026-02-15\",\n    \"appointment_time\": \"14:00\",\n    \"duration_minutes\": 60,\n    \"notes\": \"Direct booking\",\n    \"chat_session_id\": \"{{sessionId}}\"\n}",
